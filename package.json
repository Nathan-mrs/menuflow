{
  "name": "menuflow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "npm start",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.production server/production.js",
    "test": "npm run cf:build && node --test tests/*.test.js",
    "cf:dev": "wrangler pages dev dist --port 8788",
    "cf:migrate:local": "wrangler d1 migrations apply menuflow-db --local",
    "cf:migrate": "wrangler d1 migrations apply menuflow-db --remote",
    "cf:build": "wrangler pages functions build --outdir=.wrangler/build",
    "cf:deploy": "wrangler pages deploy dist --project-name=menuflow --branch=main",
    "cf:credentials": "node --env-file-if-exists=.env scripts/cloudflare-credentials.js",
    "cf:secrets": "wrangler pages secret bulk .cloudflare-secrets.json --project-name=menuflow"
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "miniflare": "^5.20261006.1-alpha",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0",
    "wrangler": "^4.149.0"
  }
}
